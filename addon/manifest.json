{
  "manifest_version": 2,
  "name": "Local PDF Translate",
  "version": "0.1.0",
  "description": "Translate Zotero PDFs locally with your own OpenAI-compatible API, and attach mono and dual PDFs.",
  "author": "liuwenbo0",
  "icons": {
    "48": "content/ui/icons/translate.svg",
    "96": "content/ui/icons/translate.svg"
  },
  "homepage_url": "https://github.com/liuwenbo0/zotero-local-translate",
  "applications": {
    "zotero": {
      "id": "local-pdf-translate@liuwenbo0.github.io",
      "strict_min_version": "10.0",
      "strict_max_version": "10.0.*",
      "update_url": "https://github.com/liuwenbo0/zotero-local-translate/releases/latest/download/updates.json"
    }
  }
}
